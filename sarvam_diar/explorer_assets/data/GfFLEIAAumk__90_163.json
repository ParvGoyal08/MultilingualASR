  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 0.01,
      "end": 5.95,
      "text": "এক থেকে তিন শতাংশ পর্যন্ত বাড়তি আদায় করছে বলে অভিযোগ করেছেন ঋণগ্রহীতা উদ্যোক্তারা"
    },
    {
      "speaker": "Speaker_A",
      "start": 6.55,
      "end": 31.33,
      "text": "দর্শক এমন পরিস্থিতিকে সামনে রেখেই আজ আমাদের আলোচনার বিষয় প্রতিশ্রুত সুদ হার ও বাস্তবতা আর এ বিষয়ে আলোচনার জন্য আজ আমাদের সাথে আছেন বাংলাদেশ ব্যাংকএর সাবেক ডেপুটি গভর্নর খন্দকার ইব্রাহিম খালেদ স্ট্যান্ডার্ড ব্যাংকএর ব্যবস্থাপনা পরিচালক মামুনুর রশিদ এবং সিপিডির রিসার্চ ফেলো তৌফিকুল ইসলাম খান যাচ্ছি মূল আলোচনায় জনাব মামুনুর রশিদ আপনাকে দিয়ে আমাদের আজকের আলোচনা শুরু করছি প্রতিশ্রুতি দিয়ে অধিকাংশ ব্যাংক"
    },
    {
      "speaker": "Speaker_A",
      "start": 31.65,
      "end": 40.83,
      "text": "এখনো ঋণের যে সিঙ্গেল ডিজিটএ নামিয়ে আনার যে প্রতিশ্রুতি কিংবা ঋণের সুদ হার কমায়নি সরকার ব্যাংকগুলোকে নানা সুবিধা দেবার পরেও"
    },
    {
      "speaker": "Speaker_B",
      "start": 38.65,
      "end": 39.29,
      "text": "না"
    },
    {
      "speaker": "Speaker_A",
      "start": 41.19,
      "end": 42.65,
      "text": "তারা কেন কথা রাখল না"
    },
    {
      "speaker": "Speaker_B",
      "start": 42.63,
      "end": 46.03,
      "text": "আপনি যেটা বলেছেন সেটা আসলে পুরোপুরি সত্য নয়"
    },
    {
      "speaker": "Speaker_A",
      "start": 45.97,
      "end": 47.03,
      "text": "পুরোপুরি সত্য নয়"
    },
    {
      "speaker": "Speaker_A",
      "start": 47.33,
      "end": 48.27,
      "text": "না মানে ফাঁক আছে"
    },
    {
      "speaker": "Speaker_B",
      "start": 48.27,
      "end": 55.73,
      "text": "না ফাঁক না আমরা ইতিমধ্যেই কিন্তু আমাদের আপনি যদি আমাদের ওয়েবসাইটএ যান তাহলে আপনি দেখতে পাবেন আমাদের যে ঋণের সুদের হার আমরা এক অংকে নামিয়ে এনেছি"
    },
    {
      "speaker": "Speaker_A",
      "start": 55.77,
      "end": 57.67,
      "text": "জি এটা আমাদের মানে আপনি কাদের বলছেন"
    },
    {
      "speaker": "Speaker_B",
      "start": 57.41,
      "end": 69.45,
      "text": "মানে এটা সব ব্যাংকএরই আপনি সব ব্যাংকএরই আপনি ওয়েবসাইটএ যদি যান তাহলে আপনি যেহেতু এখন আমাদের ডিক্লারেশন দিতে হয় আমাদের এটা হচ্ছে একটা এটা এটা এটা একটা বাধ্যবাধকতা আছে আইনগত আমার আমার ওয়েবসাইটএ আমার সব রেটেরএর"
    },
    {
      "speaker": "Speaker_A",
      "start": 63.51,
      "end": 63.97,
      "text": "জি"
    },
    {
      "speaker": "Speaker_B",
      "start": 69.57,
      "end": 73.0,
      "text": "ইন্টারেস্ট রেট আমার এবং ডিপোজিটএর ইন্টারেস্ট রেট আমাদের সবগুলো কিন্তু পাবলিশ করতে হয় এবং জনগণ যেকোনো সময় এটা ভিজিট"
    }
  ],
