  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 1.49,
      "end": 1.97,
      "text": "हाय मम्मा"
    },
    {
      "speaker": "Speaker_B",
      "start": 2.53,
      "end": 10.67,
      "text": "हुँ कब से ट्राई कर रही हूँ मैं ये लैपटॉप में कुछ प्रॉब्लम है सर्विसिंग करानी पड़ेगी शायद बंटी को बोलना पड़ेगा"
    },
    {
      "speaker": "Speaker_A",
      "start": 10.99,
      "end": 16.79,
      "text": "मां नेटवर्क में प्रॉब्लम है कितनी बार बोला लैपटॉप बिल्कुल ठीक है एनीवे आप बताओ आप कैसे हो आपकी तबीयत कैसी है"
    },
    {
      "speaker": "Speaker_B",
      "start": 17.27,
      "end": 28.91,
      "text": "ठीक हूँ बेटा चल रहा है ओ आई फॉरगॉट टू टेल यू चक्र हीलिंग जॉइन करी है मैंने इट्स सो इंटरेस्टिंग इट कीप्स यू फिजिकली एंड इमोशनली emotionally हेल्दी यंग लोग भी आते हैं"
    },
    {
      "speaker": "Speaker_B",
      "start": 30.15,
      "end": 31.31,
      "text": "तुझे भी ट्राई करना चाहिए"
    },
    {
      "speaker": "Speaker_A",
      "start": 32.03,
      "end": 33.47,
      "text": "मम्मा चक्राज इस सो"
    },
    {
      "speaker": "Speaker_A",
      "start": 34.67,
      "end": 35.5,
      "text": "सो बोरिंग"
    },
    {
      "speaker": "Speaker_B",
      "start": 36.33,
      "end": 40.35,
      "text": "अच्छा वो फोटोज देखे व्हाट्सएप पे जो मैंने भेजे थे सच गर्ल्स ना"
    },
    {
      "speaker": "Speaker_A",
      "start": 40.79,
      "end": 42.61,
      "text": "नहीं सॉरी माँ आई हैव बीन रियली बिजी"
    },
    {
      "speaker": "Speaker_B",
      "start": 43.99,
      "end": 46.07,
      "text": "वो क्या था कोई है तुम्हारे साथ"
    },
    {
      "speaker": "Speaker_A",
      "start": 46.71,
      "end": 50.03,
      "text": "नहीं क्यों कुछ नहीं व्हाई वुड यू से दैट कोई नहीं"
    },
    {
      "speaker": "Speaker_B",
      "start": 50.47,
      "end": 53.0,
      "text": "अरे कोई है अभी अभी तुम्हारे पीछे किसी को"
    }
  ],
