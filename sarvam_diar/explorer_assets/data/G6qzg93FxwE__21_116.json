  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 1.19,
      "end": 19.65,
      "text": "નાતા ધોતા કા તો પછી નોર્મલી પણ હાય હલો કરતા કે પછી દરવાજાની સ્ટોપર વાજતી વખતે આપણને જે આ દુ ખાવો થાય ને એનું નામ છે ફ્રોઝન શોલ્ડર હવે શું સર્જરી જ આનો એકમાત્ર ઉપાય છે કે પછી ફિઝિયોથેરાપીથી આને થોડું ટાળતા રહીએ ટાળતા રહીએ એ જ ઉપાય છે"
    },
    {
      "speaker": "Speaker_A",
      "start": 19.85,
      "end": 34.33,
      "text": "આ દરેક સવાલોના જવાબ માટે વી હેવ ડોક્ટર ડિમ્પલ એન્ડ ડોક્ટર રોઝિલ ગાંધી વિથ અસ સો સૌથી પહેલા તો ફ્રોઝન શોલ્ડર આને નાબૂદ કરવા માટેની કન્વેન્શનલ મેથડ જે હતી જે ટેકનોલોજી હતી એ કઈ હતી સૌથી પહેલા તો મારે એ જાણવી છે"
    },
    {
      "speaker": "Speaker_B",
      "start": 34.79,
      "end": 49.13,
      "text": "ફર્સ્ટ ઓફ ઓલ કે આપણે ફ્રોઝન શોલ્ડર વિશે વાત કરીએ તો ફ્રોઝન શોલ્ડરમાં મેઇનલી શું હોય છે કે આપણું જે ખભાનો સાંધો હોય છે એના ફરતે એક આખું આવરણ આવેલું હોય છે જેને આપણે કેપ્સ્યુલ કહીએ છીએ એ કેપ્સ્યુલ આખી ટાઈટ થાય છે જેના લીધે થઈને પેઈન થાય છે"
    },
    {
      "speaker": "Speaker_A",
      "start": 45.07,
      "end": 45.45,
      "text": "ઓકે"
    },
    {
      "speaker": "Speaker_B",
      "start": 49.29,
      "end": 67.35,
      "text": "પછી જે રેન્જ રેન્જ ઓફ મોશન જે મુવમેન્ટ કહીએ એ બધું રિસ્ટ્રીક્ટ થાય છે હવે એની ટ્રીટમેન્ટ માટે આપણે જોઈએ તો એનો ફર્સ્ટ ઓપ્શન એ છે કે ફિઝિયોથેરાપીથી સારવાર લે હવે ફિઝિયોથેરાપીથી સારવાર લે તો એમાંથી એઈટી ટુ એઈટી ફાઈવ પર્સેન્ટેજ પેશન્ટ એવા હોય છે કે ઓન્લી ફિઝિયોથેરાપીથી જ ક્યોર થઈ જાય છે"
    },
    {
      "speaker": "Speaker_A",
      "start": 67.17,
      "end": 67.61,
      "text": "ઓકે"
    },
    {
      "speaker": "Speaker_B",
      "start": 67.79,
      "end": 87.71,
      "text": "બટ બાકી વધતા જે ફિફ્ટીન ટુ ટેન પર્સન્ટ જે પેશન્ટ છે એ પેશન્ટ એવા હોય છે કે જેને ફિઝિયોથેરાપીથી ઈફેક્ટ નથી આવતી તે પેશન્ટને શોલ્ડર મેનિપ્યુલેશનથી સારવાર આપવામાં આવે છે જેમાં જનરલ એનેસ્થેશિયાના ગાઈડન્સની અંદર જે શોલ્ડર જોઈન્ટ હોય છે એ આખો રોટેટ કરવામાં આવે છે એટલે એ લુઝનિંગ થાય છે"
    },
    {
      "speaker": "Speaker_B",
      "start": 88.05,
      "end": 95.0,
      "text": "અને મુવમેન્ટ છે એ પેશન્ટની થોડી ખુલે છે એટલે જે ડેઈલીની ક્રિયાઓ એમની બધી હોય છે એક્ટિવિટીસ એમાં રિલીફ મળે છે"
    }
  ],
