  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 9.61,
      "end": 11.01,
      "text": "മോളെ എന്തൊരു ഇരിപ്പാ ഇത്"
    },
    {
      "speaker": "Speaker_B",
      "start": 17.49,
      "end": 21.31,
      "text": "ഇങ്ങനെ ഇരുന്ന് കരഞ്ഞുകൊണ്ട് ഒരു ഗുണവുമില്ല എല്ലാം ഒരു ദുസ്വപ്നമായി കൂട്ടിയാൽ മതി"
    },
    {
      "speaker": "Speaker_B",
      "start": 27.41,
      "end": 33.57,
      "text": "നിങ്ങൾ രണ്ടാളും ഒരുപാട് ആശിച്ചതല്ലേ നീയും അവനെ ശിക്ഷിക്കരുത് വേണമെങ്കിൽ നിന്റെയും അപ്പുവിന്റെയും കല്യാണം"
    },
    {
      "speaker": "Speaker_C",
      "start": 34.55,
      "end": 34.95,
      "text": "വേണ്ട"
    },
    {
      "speaker": "Speaker_C",
      "start": 35.41,
      "end": 36.35,
      "text": "എന്നോട് ഒന്നും പറയണ്ട"
    },
    {
      "speaker": "Speaker_C",
      "start": 37.01,
      "end": 38.35,
      "text": "അപ്പുവിന്റെ പേര് എനിക്ക് കേൾക്കണ്ട"
    },
    {
      "speaker": "Speaker_D",
      "start": 49.97,
      "end": 54.77,
      "text": "ഞാൻ തെറ്റൊന്നും ചെയ്തിട്ടില്ല അമ്മേ അവള് ആ അമ്മു എന്നെ ചതിച്ചതാ അമ്മയെങ്കിലും എന്നെ വിശ്വസിക്കണം"
    },
    {
      "speaker": "Speaker_E",
      "start": 55.11,
      "end": 70.65,
      "text": "അപ്പു നീ തെറ്റൊന്നും ചെയ്തിട്ടില്ലെന്ന് എനിക്കറിയാം എനിക്ക് നിന്നെ വിശ്വാസമാണ് അത് ഞാൻ നിന്റെ അമ്മയായതുകൊണ്ടാ അതേസമയം ഞാൻ മായയുടെ സ്ഥാനത്തായിരുന്നെങ്കിൽ ഒരിക്കലും നിന്നെ ഞാൻ വിശ്വസിക്കില്ല അപ്പുആ ബന്ധം നമുക്ക് വേണ്ട മോനെ നീ അങ്ങ് മറന്നേക്ക്"
    },
    {
      "speaker": "Speaker_D",
      "start": 70.65,
      "end": 73.45,
      "text": "കഴിയില്ല അമ്മേ എത്ര വർഷമായി ഞാൻ ഈ നെഞ്ചിൽ കൊണ്ടുനടക്കുന്നതാ"
    },
    {
      "speaker": "Speaker_F",
      "start": 74.09,
      "end": 74.51,
      "text": "അപ്പു"
    },
    {
      "speaker": "Speaker_F",
      "start": 74.51,
      "end": 76.0,
      "text": "മായയെ എല്ലാവരും ചേർന്ന് സമ്മതിപ്പിച്ചെടാ അവളെ കൊട്ടാരത്തിൽ കൊണ്ടുപോവണ്"
    }
  ],
