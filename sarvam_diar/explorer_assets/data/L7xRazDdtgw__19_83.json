  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 6.11,
      "end": 7.04,
      "text": "શું કરો છો મમ્મી"
    },
    {
      "speaker": "Speaker_B",
      "start": 7.29,
      "end": 15.77,
      "text": "આ આ મોબાઈલની અંદર પેલા ભજન આવે છે ને તો વહુએ શીખવાડ્યું હતું એકવાર તે મથી રહી છું બેટા"
    },
    {
      "speaker": "Speaker_A",
      "start": 16.15,
      "end": 19.67,
      "text": "અચ્છા અં દામિની ક્યાં છે બોલાવજોને થોડી વાત કરવી છે"
    },
    {
      "speaker": "Speaker_B",
      "start": 20.15,
      "end": 25.2,
      "text": "દામિની વહુને હા બોલાવું અં દામિની વહુ"
    },
    {
      "speaker": "Speaker_B",
      "start": 26.41,
      "end": 27.55,
      "text": "દામિની બેટા"
    },
    {
      "speaker": "Speaker_C",
      "start": 30.15,
      "end": 31.12,
      "text": "એ આવી"
    },
    {
      "speaker": "Speaker_C",
      "start": 40.13,
      "end": 41.75,
      "text": "બીજું કંઈ કામ હતું"
    },
    {
      "speaker": "Speaker_B",
      "start": 41.87,
      "end": 48.42,
      "text": "અં ના કામ મારે નહોતું રોનકને હતું અં રોનક"
    },
    {
      "speaker": "Speaker_A",
      "start": 48.65,
      "end": 51.51,
      "text": "મારે તમારા લોકો સાથે થોડી વાત કરવી હતી"
    },
    {
      "speaker": "Speaker_B",
      "start": 52.33,
      "end": 55.4,
      "text": "હા બોલને બેટા શું વાત કરવી છે"
    },
    {
      "speaker": "Speaker_C",
      "start": 55.41,
      "end": 57.68,
      "text": "હા તમારી સાથે વાત કરવી છે હું"
    },
    {
      "speaker": "Speaker_A",
      "start": 57.63,
      "end": 62.61,
      "text": "ના ના મારે તમારા બંને સાથે વાત કરવી છે મીરા અને આદી વિશે"
    },
    {
      "speaker": "Speaker_B",
      "start": 62.77,
      "end": 64.0,
      "text": "મીરા અને આદી વિશે હું કંઈ સમજી નહીં બેટા"
    }
  ],
