  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 0.01,
      "end": 3.65,
      "text": "தேங்க் யூ ரொம்ப ஹெல்த்தியா இருக்கு இந்த பொங்கல்"
    },
    {
      "speaker": "Speaker_A",
      "start": 3.97,
      "end": 22.97,
      "text": "ஜெனரலாரா முன்னாடிலாம் நாலஞ்சு படம் ஒரு பெஸ்டிவல்னா ரிலீஸ் ஆகும் இப்பெல்லாம் வந்து டூ இயர்ஸ் முன்னாடி வரைக்கும் சொல்லி நான் கேள்விப்பட்டிருக்கேன் ஜெனரலாரா ஒரு படம்தான் இந்த டைம்ல ரிலீஸ் பண்ண முடியும் அப்படின்னு சோ இட்ஸ் நைஸ் ஹெல்த்தி தேங்க் யூ"
    },
    {
      "speaker": "Speaker_B",
      "start": 23.39,
      "end": 24.49,
      "text": "எல்லாருக்கும் வணக்கம்"
    },
    {
      "speaker": "Speaker_B",
      "start": 26.01,
      "end": 32.11,
      "text": "இவ்வளவு பெரிய ஒரு வெற்றி படத்துல நான் இருக்கேன்னு நினைக்கிறப்ப ரொம்ப சந்தோஷமா இருக்குது நிஜமா படம் மிகப்பெரிய வெற்றி பெற்றுருக்கு"
    },
    {
      "speaker": "Speaker_B",
      "start": 32.71,
      "end": 40.73,
      "text": "பார்க்காதவங்க எல்லாம் இந்த படம் மிகப்பெரிய வெற்றி அடைஞ்சுருக்கு அப்படின்னு ஒரு படத்த ஃபுல்லா சொல்லி இன்னைக்கு எல்லாத்தையும் தியேட்டர்ல போய் உட்கார வச்சுருக்கீங்க அதுக்கு உங்களுக்கு ரொம்ப நன்றி சொல்லிக்கிறேன்"
    },
    {
      "speaker": "Speaker_B",
      "start": 41.45,
      "end": 58.71,
      "text": "இந்த படத்துல எனக்கு வாய்ப்பு கொடுத்த சவுத்ரி சாருக்கும் நேசனுக்கும் இளையதளபதி விஜய் அண்ணனுக்கும் ரொம்ப நன்றி தெரிவிச்சுக்கிறேன் ஏன்னா ஒரு படம் ரிலீஸ் ஆகி வெற்றி அடைஞ்சு இன்னைக்கு உங்க முன்னாடி நிக்கிறேன் நானு வேலாயுதம் படத்துல வந்து சும்மா ஒரு அப்பப்போ ஃபர்ஸ்ட் ஹாப்ல கொஞ்சம் செகண்ட் ஹாப்ல கொஞ்சம் வந்துருப்பேன்"
    },
    {
      "speaker": "Speaker_B",
      "start": 58.93,
      "end": 61.65,
      "text": "இந்த படத்துல விஜய் அண்ணன் கூட தொடர்ந்து வரணும்"
    },
    {
      "speaker": "Speaker_B",
      "start": 63.01,
      "end": 69.59,
      "text": "இப்படி ஒரு வாய்ப்பை ஃபர்ஸ்ட்டா அவங்க முடிவு பண்ணது பெரிய விஷயம் எல்லாரும் இருக்கறதுல சூரி கரெக்டா இருப்பான்"
    },
    {
      "speaker": "Speaker_B",
      "start": 70.63,
      "end": 78.19,
      "text": "ஈக்குவலா கம்பெனியா இருக்கும் நல்லா நடிச்சிருவான் அப்படின்னு அவங்களுக்கு நம்பிக்கை வந்தது பெரிய விஷயம் இப்படி நம்பிக்கை கொடுத்த எல்லாருக்கும் ரொம்ப தேங்க்ஸ் சொல்லிக்கிறேன் நானு"
    },
    {
      "speaker": "Speaker_B",
      "start": 79.21,
      "end": 91.27,
      "text": "அதுக்கப்புறம் விஜய் அண்ணனை பத்தி தனியா சொல்றதுக்கு இப்படி ஒரு இடத்தை சொல்றது எனக்கு அது பெருமையா இருக்குது இன்னைக்கு இவ்வளவு பெரிய ஒரு இடத்துல விஜய் அண்ணன் இருக்காருன்னா நடிக்கிறப்ப எல்லாத்துக்கும் ஒரு சப்போர்ட்"
    },
    {
      "speaker": "Speaker_B",
      "start": 92.45,
      "end": 103.63,
      "text": "ஹீரோவா வந்து டான்ஸ் மட்டும் இல்லாம எல்லாத்தையுமே விஜய் அண்ணனுக்கு எல்லாத்தையும் தெரியும் அதே மாதிரி நகைச்சுவை ஏரியாவ நூறு சதவீதம் நிறைவுப்படுத்துவாரு அவரு அது எல்லாத்துக்கும் தெரிஞ்ச விஷயம் ஆனா அவரு கூட நடிக்கிற ஒரு நகைச்சுவை நடிகனும் சரி"
    },
    {
      "speaker": "Speaker_B",
      "start": 103.93,
      "end": 123.77,
      "text": "நான் ஒரு டயலாக் பேசுறப்ப ஒரு சின்ன இது சப்போஸ் அண்ணன் பேசுறப்ப எனக்கு ஏதாவது ஒன்னு தோணும் அது அண்ணன்கிட்ட சொல்லுவேன் அப்படியா சரி ஓகே அப்ப நான் அந்த டயலாக் நான் சொல்ல வேண்டாம் சொன்னா நல்லா இருக்காதுல கரெக்ட் தானே அப்ப நீங்களே பண்ணிருங்கன்னுவாரு சரிங்கண்ணே ஓகே ரொம்ப தேங்க்ஸ் அண்ணா அப்ப நான் பண்ணிட்டு இருக்கப்ப சூரி இந்த இடத்துல ஒரு சின்ன பிரேக் விட விட்டா நான் போய் ரியாக்ஷன் பண்ணிக்கலாமா"
    },
    {
      "speaker": "Speaker_B",
      "start": 123.99,
      "end": 134.0,
      "text": "எனக்கு அண்ணன்கிட்ட கேக்குறப்ப என்னன்னா எப்படி கேக்குறது இல்ல இல்ல உங்களால கண்டினியூவா பேச முடிஞ்சா பேசுங்க சப்போஸ் இந்த இடத்துல கேப் விட முடியுமா நான் பண்ணிக்கலாமா அப்படின்னுவாரு அந்த பொண்ணு பார்க்க போற இடத்துல அந்த கதவை தட்டுவார்"
    }
  ],
