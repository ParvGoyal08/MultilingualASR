  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 0.11,
      "end": 20.05,
      "text": "हो लाईक हा ही पहिलीच वेळ आहे मी अवॉर्ड फंक्शनमध्ये पफॉम करतेय सो एक्साइटमेंट आहे नर्व्हसनेस आहे अ पण म्हणजे असं वाटतंय की मज्जा तर मज्जा तर येतेच ऑलरेडी की आणि आता ड्रेसअप पण झालंय त्यामुळे अजून थोडंसं छान वाटतंय सो बघूयात आता कसा होतोय पफॉमन्स"
    },
    {
      "speaker": "Speaker_B",
      "start": 20.49,
      "end": 28.05,
      "text": "अनेक मालिकांमध्ये निगेटिव्ह पॉझिटिव्ह रोल्स केलेस पण आत्ता अ रेड कार्पेटवर वॉक करणं दडपणाचं वाटतं की नाही मजा येते"
    },
    {
      "speaker": "Speaker_C",
      "start": 28.33,
      "end": 53.03,
      "text": "अ असं नर्व्हसनेस नाही आहे फार कारण नवीन नाही आहे दुसरी गोष्ट म्हणजे अ रेड कार्पेटवरती चालण्यापेक्षा अ असं सजून नटून छान सगळ्यांना भेटणं आता वेगवेगळ्या सिरियल्समध्ये अ सगळे मित्रच काम करत असतात मग ते या निमित्ताने या ॲवॉर्ड शोच्या निमित्ताने भेटत असतात तर त्यांच्याशी इंटरॅक्शन होतं सगळे जरा शूटबीटच्या याच्यातनं जरा रिलॅक्स होऊन एकमेकांशी गप्पा गोष्टी होतात"
    },
    {
      "speaker": "Speaker_C",
      "start": 53.87,
      "end": 62.0,
      "text": "एकमेकांचं शूट कसं चाललंय कसं चाललंय वातावरण कसं एकंदरीत काय चालू आहे आयुष्यात हे सगळ्या गोष्टी करतात त्याच्यामुळे मजा येते एक्साइटमेंट लेवल उलट जास्त असते"
    }
  ],
