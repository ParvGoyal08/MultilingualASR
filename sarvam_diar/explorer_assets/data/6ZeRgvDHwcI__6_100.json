  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 11.39,
      "end": 12.27,
      "text": "હું કરે છે આ"
    },
    {
      "speaker": "Speaker_B",
      "start": 13.71,
      "end": 15.67,
      "text": "પગે લાગું છું હું કરે છે હું"
    },
    {
      "speaker": "Speaker_A",
      "start": 16.99,
      "end": 24.21,
      "text": "કેટલી વાર ના પાડી છે મેં હં મને આ તારા ધતીંગ ગમતા નથી આજ પછી ક્યારેય મને પગે ના લાગતી તું"
    },
    {
      "speaker": "Speaker_B",
      "start": 26.07,
      "end": 33.27,
      "text": "કેમ હું તો મારો ધર્મ નિભાવું છું ને એમાં શું વાંધો હશે ઈશ્વર પછીનો બીજો દરજ્જો ધણીને દેવાનો હોય"
    },
    {
      "speaker": "Speaker_B",
      "start": 34.61,
      "end": 37.23,
      "text": "તમને વાંધો શું છે મારાથી"
    },
    {
      "speaker": "Speaker_A",
      "start": 36.73,
      "end": 44.83,
      "text": "અરે ભાડમાં ગયો તારો ધર્મ હું નથી માનતો આ ધર્મને અને નથી માનતો તને મારી પત્ની કેટલી વાર કહેવાનું તને"
    },
    {
      "speaker": "Speaker_A",
      "start": 46.57,
      "end": 49.07,
      "text": "આ સામે મારા ઘરની ડેલી છે હં"
    },
    {
      "speaker": "Speaker_A",
      "start": 50.47,
      "end": 57.13,
      "text": "ગમે ત્યારે જઈ શકે છે તું પણ તું છે કે આ ઘરમાંથી જવા નથી માંગતી શું ધાર્યું છે તે"
    },
    {
      "speaker": "Speaker_B",
      "start": 57.81,
      "end": 59.71,
      "text": "જ્યારે હોય ત્યારે એક ને એક વાત લઈને બેસો છો"
    },
    {
      "speaker": "Speaker_B",
      "start": 61.01,
      "end": 62.63,
      "text": "કે ડેલી ખુલ્લી છે વઈ જા અહીંયાથી"
    },
    {
      "speaker": "Speaker_B",
      "start": 63.77,
      "end": 75.51,
      "text": "તમે મને આજ સુધી કોઈ દી કારણ નથી કીધું કે તમને મારાથી વાંધો શું છે હું કઈ ભૂલમાં આવી ગઈ છું મારા કઈ શબ્દો ખોટા લાગ્યા છે મારું કઈ વર્તન ખોટું લાગ્યું છે એકવાર મને કહી દો ને"
    },
    {
      "speaker": "Speaker_A",
      "start": 75.71,
      "end": 77.29,
      "text": "હંધાય કારણ કહેવાના ના હોય"
    },
    {
      "speaker": "Speaker_A",
      "start": 78.45,
      "end": 79.73,
      "text": "અને તું એ કારણ જ છો"
    },
    {
      "speaker": "Speaker_A",
      "start": 81.73,
      "end": 85.23,
      "text": "આ મારા ઘરમાં તારા માટે કોઈ માન નથી"
    },
    {
      "speaker": "Speaker_A",
      "start": 86.27,
      "end": 87.51,
      "text": "ફક્ત કામવાળી છો"
    },
    {
      "speaker": "Speaker_A",
      "start": 89.11,
      "end": 90.99,
      "text": "પત્ની બનીને આ ઘરમાં તો આવી ગઈ તું"
    },
    {
      "speaker": "Speaker_B",
      "start": 89.19,
      "end": 89.47,
      "text": "પત્ની"
    },
    {
      "speaker": "Speaker_A",
      "start": 92.31,
      "end": 92.67,
      "text": "પણ"
    }
  ],
