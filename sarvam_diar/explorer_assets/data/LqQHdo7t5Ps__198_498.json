  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 0.01,
      "end": 14.95,
      "text": "हो त्यांना लवकर वयामध्येही मोतीबिंदू होण्याची शक्यता असते अ याखेरीज अ काही व्यसनं असतात की अत अ अति मद्यपान किंवा अति धूम्रपान ह्या या गोष्टींमुळे सुद्धा मोतीबिंदू लवकर होण्याची शक्यता असते"
    },
    {
      "speaker": "Speaker_A",
      "start": 15.33,
      "end": 30.29,
      "text": "काही अ प्रोफेशनल हझार्ड असतात काही प्रोफेशन्स असतात ज्याच्यामध्ये व्यक्ती ज्या अ इन्फ्रारेड किंवा युव्ही रेझला एक्सपोज होतो किंवा काही केमिकल फ्युम्सला जास्त एक्सपोज होतो अशा व्यक्तींना पण मोतीबिंदू लवकर होण्याची शक्यता जास्त असते"
    },
    {
      "speaker": "Speaker_A",
      "start": 30.73,
      "end": 53.97,
      "text": "अ काही सिस्टेमिक डिसीजेस असतात ज्याच्यामध्ये आपण अ आम्हाला पेशंट्सला स्टिरॉइड्स नावाचे औषधं देखील द्यावे लागतात अशा व्यक्तींमध्ये या स्टिरॉइड्सच्या सेवना अति अतिव जास्त काळ सेवनामुळे देखील मोतीबिंदू होण्याची शक्यता नाकारता येत नाही अ याखेरीज अनेक अशी कारणं आहेत काही बालकांना देखील जन्मजात मोतीबिंदू होण्याची पण अ विविध कारणं आहेत"
    },
    {
      "speaker": "Speaker_B",
      "start": 54.39,
      "end": 68.05,
      "text": "अ डॉक्टर अमिता खरंतर अ पुढचा प्रश्न तुमच्याकडेच येते की यात लक्षणं आणखी काय असतात आणि दुसरी गोष्ट म्हणजे जेव्हा रुग्णाला ई मोतीबिंदूचा आपल्याला त्रास होतोय ही लक्षणं जेव्हा जाणवत असतात तेव्हा नेमकं अ काय करायचं असतं"
    },
    {
      "speaker": "Speaker_C",
      "start": 68.93,
      "end": 86.67,
      "text": "मोतीबिंदू किंवा कॅटरॅक्ट ज्या रुग्णांना झालेला असतो त्यांना मुख्यतः अस्पष्ट दिसतं डोळ्यासमोर असा धुरकट पडदा आल्यासारखा भास होऊ शकतो काहींना अ रात्रीच्या वेळेस विशेष डिस्कम्फर्ट जाणवतो अ जसं की गाडी चालवताना त्रास होणे अ त्याचबरोबर काही लोकांना अ रंगही फिकट दिसू शकतात"
    },
    {
      "speaker": "Speaker_C",
      "start": 87.17,
      "end": 96.83,
      "text": "काही लोकांना अ रात्रीच्या वेळेस डिस्कम्फर्ट जाणवू शकतो गाडी चालवताना त्रास होऊ शकतो याशिवाय अ हे मोतीबिंदूच्या प्राथमिक टप्प्यातील अ लक्षणं झाली"
    },
    {
      "speaker": "Speaker_C",
      "start": 97.09,
      "end": 108.49,
      "text": "याच वेळेस अ व्यक्तीने आपल्या नेत्रतज्ज्ञांची गाठ घेतली पाहिजे जेणेकरून नेत्रतज्ज्ञ त्यांच्या अ डोळ्याची तपासणी करून मोतीबिंदूचं निदान करून त्याच्यासाठी योग्य ते उपचार गाईड करू शक"
    },
    {
      "speaker": "Speaker_B",
      "start": 108.51,
      "end": 113.59,
      "text": "डॉक्टर अमिता अ खरंतर टेस्टविषयी आपण जरा बोलूयात की टेस्ट कुठल्या पद्धतीच्या करायला लागतात"
    },
    {
      "speaker": "Speaker_C",
      "start": 113.91,
      "end": 133.99,
      "text": "अ मोतीबिंदू असलेल्या रुग्णांनी वेळीच जर आपल्या नेत्रतज्ज्ञांची गाठ घेतली तर हे नेत्रतज्ज्ञ अ आपल्या डोळ्यांची रितसर तपासणी करतात जसं की डोळ्याची नजरेची तपासणी अ चष्म्याच्या नंबरची तपासणी अ अं डोळ्यामध्ये ड्रॉप सोडून अ डोळ्याची रितसर तपासणी करून तसंच डोळ्यावरचा दाब"
    },
    {
      "speaker": "Speaker_C",
      "start": 134.35,
      "end": 144.94,
      "text": "अ मोतीबिंदूची ग्रेड अ आणि त्याच्यानुसार व्यक्तीला कोणत्या अ शस्त्रक्रियेची गरज आहे याविषयी मार्गदर्शन करू शकतात तेव्हा अ म त्याही पूर्वी"
    },
    {
      "speaker": "Speaker_B",
      "start": 145.05,
      "end": 145.26,
      "text": "हं"
    },
    {
      "speaker": "Speaker_C",
      "start": 145.28,
      "end": 152.06,
      "text": "मोतीबिंदू शस्त्रक्रियेपूर्वी काही अ प्राथमिक अ रक्ताच्या ता चाचण्या आणि अं ब्लड प्रेशर आणि"
    },
    {
      "speaker": "Speaker_C",
      "start": 152.19,
      "end": 161.15,
      "text": "अन रक्तदाब असेल तर त्यानुसार काही नॉमिनल तपासण्या दिल्या जातात आणि पेशंटचा फिटनेस चेक करून मग त्याला मोतीबिंदू शस्त्रक्रियेसाठी सज्ज केलं जातं"
    },
    {
      "speaker": "Speaker_B",
      "start": 161.27,
      "end": 176.35,
      "text": "अ डॉक्टर अमिता पुढचा प्रश्न खरंतर तुम्हालाच आहे तो म्हणजे असा की अ जर या प्रकारे वेळीच नेत्ररोग तज्ज्ञांकडून मोतीबिंदूचं निदान आणि त्यावरचे उपचार जे आहेत ते वेळेवर झाले नाहीत तर पुढे काय परिणाम होऊ शकतात"
    },
    {
      "speaker": "Speaker_C",
      "start": 176.65,
      "end": 196.03,
      "text": "अ ओके जसा मे मोतीबिंदू हा वाढत जातो तसं तसं अ ही लक्षणं जी आहेत ती तीव्र होऊ लागतात आणि व्यक्तीची व्हिजन हळूहळू कमी होऊ लागते अ याही वेळेस जर मोतीबिंदूला उपचार घेतले नाहीत तर मग हा मोतीबिंदू आमच्या भाषेमध्ये मॅच्युअर होतो म्हणजेच अ हा मोतीबिंदू अ म"
    },
    {
      "speaker": "Speaker_C",
      "start": 196.27,
      "end": 209.25,
      "text": "वाढून त्याचं डोळ्यावरचा दाब वाढणं अ डोळ्यावरचं प्रेशर वाढून डोळ्यांचा दाब वाढणं अ डोळे दुखणं डोळ्यातून पाणी येणं डोळे लाल होणं आणि डोळ्याची मागची नस कमजोर होऊन अ व्हिजनमध्ये"
    },
    {
      "speaker": "Speaker_C",
      "start": 209.63,
      "end": 213.87,
      "text": "लक्षणीय रित्या घट होणं अशी गुंतागुंतीची परिस्थिती निर्माण होऊ शकते"
    },
    {
      "speaker": "Speaker_B",
      "start": 214.17,
      "end": 238.21,
      "text": "अच्छा अ डॉक्टर श्रुती पुढचा प्रश्न खरंतर तुम्हाला विचारत आहे तो म्हणजे असा की मोतीबिंदूसाठी कॅटरॅक्टसाठी अ शस्त्रक्रिया करण्याचा सल्ला नेत्ररोगतज्ज्ञ देतात आणि असं तुम्ही म्हणालात की अ परंतु अ अ मोतीबिंदूसाठी आणखी कुठले ड्रॉप्स किंवा अ म्हणजे असं काही आहे का की अ विना शस्त्रक्रिया आपण फक्त काही ड्रॉप्स किंवा औषधांच्या माध्यमातून अ तो घालवू शकतो"
    },
    {
      "speaker": "Speaker_A",
      "start": 238.97,
      "end": 259.89,
      "text": "अ अजिबात नाही अ मोतीबिंदू जर कोणत्या रुग्णाला असेल तर त्याच्यासाठी शस्त्रक्रिया हा एकच उपाय आहे कोणतीही ड्रॉप्स किंवा कोणत्याही लेझर पद्धती किंवा बाकी कोणत्याही डोळ्याचे उपचार करून मोतीबिंदू नाहीसा करता येत नाही त्याच्यासाठी शस्त्रक्रिया करून मोतीबिंदू काढून त्या ठिकाणी कृत्रिम लेन्स बसवणं हा एकच त्याच्यावर उपाय आहे"
    },
    {
      "speaker": "Speaker_B",
      "start": 253.39,
      "end": 253.67,
      "text": "हं हं"
    },
    {
      "speaker": "Speaker_B",
      "start": 259.99,
      "end": 275.21,
      "text": "हं हं अच्छा डॉक्टर अमिता खरंतर अ अ शस्त्रक्रिया जेव्हा आपण करतो तेव्हा या शस्त्रक्रियांमध्ये आपण नेमकं काय करतो म्हणजे आपण म्हणतो की हा मोतीबिंदूचं ऑपरेशन आपण कर अ माझं झालं पण नेमकं काय अ करता करतात या शस्त्रक्रियांमध्ये"
    },
    {
      "speaker": "Speaker_C",
      "start": 275.79,
      "end": 293.71,
      "text": "मोतीबिंदू किंवा कॅटरॅक्ट सर्जरीमध्ये आपण डोळ्यामधला हा मोतीबिंदू म्हणजे धुरकट झालेली लेन्स आहे ती काढून त्या ठिकाणी कृत्रिम लेन्सचं रोपण करतो जेणेकरून पेशंटला पूर्वीप्रमाणेच स्पष्ट दिसू शकेल मोतीबिंदूच्या या सर्जरीजमध्ये सध्या इतके रिसेंट ॲडव्हान्सेस आहेत की अ"
    },
    {
      "speaker": "Speaker_C",
      "start": 294.01,
      "end": 300.0,
      "text": "मोतीबिंदूची शस्त्रक्रिया ही पूर्वीप्रमाणे गुंतागुंतीची मुळीच राहिलेली नाही नवीन टेक्नॉलॉजीज नवीन लेझर्स लेन्सेस मशीन्स अगदी सहजरि"
    }
  ],
