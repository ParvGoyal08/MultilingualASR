  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 0.45,
      "end": 7.19,
      "text": "ലാലേട്ടൻ അങ്ങനെ ഉമ്മ കൊടുക്കാറില്ല എനിക്കൊരെണ്ണം തന്നു പിന്നെ പിന്നെ എങ്ങനെ തിരിച്ചു കൊടുക്കാണ്ട് പോകുമെന്ന് വിചാരിച്ചു"
    },
    {
      "speaker": "Speaker_B",
      "start": 6.87,
      "end": 10.14,
      "text": "അല്ല ഇന്ദ്രൻ തിരിച്ചു കൊടുക്ക"
    },
    {
      "speaker": "Speaker_B",
      "start": 12.51,
      "end": 16.39,
      "text": "ഇന്ദ്രൻസ്ചേട്ടാ ഒരുപാട് നാളത്തെ ഒരു കാത്തിരിപ്പാന്ന് തോന്നുന്നു ല്ലേ കനകരാജ്യം പോലത്തെ ഒരു സിനിമ"
    },
    {
      "speaker": "Speaker_A",
      "start": 16.33,
      "end": 32.13,
      "text": "അതെ ആ ഒരു വിനായക ഫിലിംസിന്റെ തുടക്ക സിനിമയാണ് അതിങ്ങനെ ഓരോന്നും കഴിയുമ്പോൾ നമ്മൾ ഭയങ്കര വീർപ്പുമുട്ടി കാത്തിരിക്കുകയായിരുന്നു കാരണം നമ്മൾ അത്രയും മനസ്സുകൊണ്ടൊക്കെ എല്ലാവരും ഒരു ഒരു കണക്ക് ഒപ്പിച്ച് വന്ന ഒരു സിനിമയാണ്"
    },
    {
      "speaker": "Speaker_B",
      "start": 32.65,
      "end": 38.91,
      "text": "അല്ല ഇതിൽ അഭിനയിച്ച അഭിനേതാക്കൾക്ക് അടക്കം എല്ലാ താരങ്ങൾക്കും നല്ല രീതിയിൽ ഒരു ക്യാരക്ടർ ഉണ്ട്"
    },
    {
      "speaker": "Speaker_A",
      "start": 38.37,
      "end": 40.25,
      "text": "അതെ എത്ര ചെറുതായാലും ഭയങ്കര"
    },
    {
      "speaker": "Speaker_B",
      "start": 39.83,
      "end": 44.99,
      "text": "ഒരു ഡെപ്ത്ഫീൽ ചെയ്യുന്നുണ്ട് ഒരു ക്യാരക്ടർന് എങ്ങനെയായിരുന്നു സിനിമയിലെ ഒരു അനുഭവോം കാര്യങ്ങളൊക്കെ"
    },
    {
      "speaker": "Speaker_A",
      "start": 44.95,
      "end": 60.0,
      "text": "സിനിമ അത് അതുപോലെ തന്നെ നമ്മൾ ഓരോ സീനും ചെയ്യുമ്പോഴും കോമ്പിനേഷൻ നിൽക്കുന്ന ആർട്ടിസ്റ്റുകളും ഡയറക്ടർ തരുന്ന ഫ്രീഡവും ഒക്കെ അത്രയും നമുക്ക് ആസ്വദിച്ച് ചെയ്യാൻ പറ്റുന്നതാണ് നമുക്കൊരു അവരുടെ അടുത്ത് ഒരു ഒരു ഒഴികഴിവ് പറയാതെ ചെയ്യാൻ പറ്റി"
    }
  ],
