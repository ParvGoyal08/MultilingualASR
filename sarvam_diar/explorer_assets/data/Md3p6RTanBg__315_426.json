  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 0.33,
      "end": 19.51,
      "text": "এখন অনেক ক্ষেত্রে আমরা স্যানিটাইজার ইউজ করতে হবে এটা নেসেসারি না আপনি একটু রানিং ওয়াটারএ অথবা হচ্ছে ট্যাপ বা কল যেটাই ইউজ করেন আপনি আপনার হাতটা একটু বিশ সেকেন্ড ভালোভাবে পরিষ্কার করে নিয়ে খাবার খান তাহলে দেখা যাবে যে এই ধরনের সবকিছু অসুখ থেকে আপনি নিজেকে খুব ইজিলি পরিত্রাণ করতে পারবেন"
    },
    {
      "speaker": "Speaker_B",
      "start": 19.95,
      "end": 27.87,
      "text": "অনেক ধন্যবাদ রুহি এবং সে ক্ষেত্রে আমি পরে আপনার কাছে আবার একটু জানতে চাইব যে আসলে স্পুন দিয়ে খেলে কি এটার টেন্ডেন্সিটা তাহলে কম থাকবে"
    },
    {
      "speaker": "Speaker_A",
      "start": 28.61,
      "end": 34.31,
      "text": "আপনার হচ্ছে হাত দিয়ে খাওয়ার মাধ্যমে খাবারের মাধ্যমে যদি আমি ইনজেশন করি"
    },
    {
      "speaker": "Speaker_A",
      "start": 34.45,
      "end": 56.17,
      "text": "সে ক্ষেত্রে এটার এন্টিটিটা আলাদা আর আপনি যখন কোনো একটা ইউটেনসিল ইউজ করছেন সে ক্ষেত্রে তার এন্টিটি আলাদা অর্গানিজম তো আমরা এই যে চারদিকে বসে আছি আমরা যে ব্রিদিংটা নিচ্ছি এর মাধ্যমেও যাচ্ছে আমাদের এয়ার ড্রপলেটেরএর মাধ্যমে এয়ারোসোলএর মাধ্যমে প্রত্যেকটা সারফেস কন্টামিনেটেড অবশ্যই জি জি ক্লিনটা থাকাটা দরকার সেটা আপনার হাত বা আপনার চামচ"
    },
    {
      "speaker": "Speaker_B",
      "start": 45.11,
      "end": 46.47,
      "text": "রাইট রাইট"
    },
    {
      "speaker": "Speaker_B",
      "start": 49.19,
      "end": 52.81,
      "text": "ইভেন স্পুনএও কিছু না কিছু থাকতে পারে যদি ক্লিন করা না থাকে"
    },
    {
      "speaker": "Speaker_B",
      "start": 56.55,
      "end": 72.51,
      "text": "ধন্যবাদ রুহি লোপা আপনার কাছে আসতে চাই যে আসলে হেলথ ইস্যুতে যে বিষয়টা যদিও হচ্ছে পেশায় আপনি নিউট্রিশনিস্ট বাট আসলে আমাদের মনে হয় আমরা হাইজিনটাকে সেফটিটাকে ফুডএর সাথে সবসময় রিলেট করি সো সে ক্ষেত্রে আসলে এই যে হাত ধোয়ার অভ্যাসটা"
    },
    {
      "speaker": "Speaker_B",
      "start": 72.81,
      "end": 82.91,
      "text": "কখন থেকে আসলে তৈরি করা উচিত এবং আসলে কীভাবে সেই প্র্যাকটিসটা করলে বা কীভাবে ট্রেইন করলে আমার শিশু ছোটবেলা থেকে শিখে যাবে নাকি বড় হয়েও এটা শিখতে হবে"
    },
    {
      "speaker": "Speaker_C",
      "start": 83.69,
      "end": 89.15,
      "text": "না অবশ্যই ছোটবেলা থেকে আমরা সবসময় কিন্তু বলি যে পরিবার হচ্ছে প্রথম স্কুল"
    },
    {
      "speaker": "Speaker_C",
      "start": 89.5,
      "end": 111.0,
      "text": "যে পরিবার থেকে আসলে বাচ্চারা হামাগুড়ি দিয়ে জন্মের পর হামাগুড়ি দিয়ে দাঁড়িয়ে তারপর হাঁটা শেখে ঠিক সেইভাবে সবগুলো অভ্যাসই কিন্তু পরিবার থেকেই কিন্তু মূলত প্রাথমিক শিক্ষাটা কিন্তু পরিবার থেকেই পেয়ে থাকে সে ক্ষেত্রে অবশ্যই বাবা মাকে এই ভূমিকাটা পালন করতে হবে তারা কীভাবে ক্লিনলিনেসটা তাদেরকে"
    },
    {
      "speaker": "Speaker_A",
      "start": 95.49,
      "end": 95.75,
      "text": "সেই"
    },
    {
      "speaker": "Speaker_A",
      "start": 104.21,
