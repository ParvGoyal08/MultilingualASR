  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 0.01,
      "end": 4.49,
      "text": "ਹੋਰਾਂ ਨਾਲ ਗੱਲਬਾਤ ਕਰਦੇ ਹਾਂ ਅਤੇ ਪੁੱਛਦੇ ਹਾਂ ਉਹਨਾਂ ਤੋਂ ਇਕੱਲੇ ਇਕੱਲੇ ਪਸ਼ੂ ਦੇ ਬਾਰੇ ਡਿਟੇਲ ਦੇ ਵਿੱਚ"
    },
    {
      "speaker": "Speaker_A",
      "start": 6.43,
      "end": 7.21,
      "text": "ਬਾਈ ਸਤਿ ਸ਼੍ਰੀ ਅਕਾਲ"
    },
    {
      "speaker": "Speaker_B",
      "start": 7.19,
      "end": 8.33,
      "text": "ਬਾਈ ਜੀ ਸਤਿ ਸ਼੍ਰੀ ਅਕਾਲ"
    },
    {
      "speaker": "Speaker_A",
      "start": 9.16,
      "end": 10.09,
      "text": "ਬਾਈ ਕੀ ਨਾਮ ਆਪਣਾ"
    },
    {
      "speaker": "Speaker_B",
      "start": 10.19,
      "end": 11.29,
      "text": "ਬਾਈ ਜੀ ਨਿਰਮਲ ਸਿੰਘ ਜੀ"
    },
    {
      "speaker": "Speaker_A",
      "start": 11.53,
      "end": 14.54,
      "text": "ਠੀਕ ਹੈ ਬਾਈ ਕਿੰਨਾ ਚਿਰ ਹੋ ਗਿਆ ਆਪਾਂ ਨੂੰ ਬਾਈ ਪਸ਼ੂ ਪਾਲਣ ਦਾ ਕਿੱਤਾ ਕਰਦੇ"
    },
    {
      "speaker": "Speaker_B",
      "start": 14.8,
      "end": 23.73,
      "text": "ਬਾਈ ਤਕਰੀਬਨ ਸ਼ੁਰੂ ਤੋਂ ਹੀ ਕਰਦੇ ਆਏਂ ਪਹਿਲਾਂ ਬਾਪੂ ਜੀ ਦਾਦਾ ਜੀ ਕਰਦੇ ਹੁੰਦੇ ਉਦੂ ਬਾਅਦ ਡੈਡੀ ਉਦੂ ਬਾਅਦ ਮੈਂ ਜਦੋਂ ਸੁਰਤ ਸੰਭਲੀ ਇਸੇ ਕੰਮ ਤੇ"
    },
    {
      "speaker": "Speaker_A",
      "start": 20.28,
      "end": 20.45,
      "text": "ਹੁੰ"
    },
    {
      "speaker": "Speaker_A",
      "start": 23.63,
      "end": 25.15,
      "text": "ਉਦੋਂ ਤੋਂ ਹੀ ਇੱਧਰਲੇ ਪਾਸੇ ਨੂੰ ਆ"
    },
    {
      "speaker": "Speaker_B",
      "start": 24.87,
      "end": 25.26,
      "text": "ਹਾਂਜੀ"
    },
    {
      "speaker": "Speaker_A",
      "start": 25.46,
      "end": 28.31,
      "text": "ਠੀਕ ਹੈ ਅਤੇ ਵੀਰ ਜੀ ਆਪਣੇ ਕੋਲ ਕਿੰਨੇ ਪਸ਼ੂ ਹੈ ਇਸ ਟਾਈਮ"
    },
    {
      "speaker": "Speaker_B",
      "start": 28.88,
      "end": 30.71,
      "text": "ਇਸ ਟਾਈਮ ਜੀ ਆਪਣੇ ਕੋਲ ਦਸ ਪਸ਼ੂ ਆ"
    },
    {
      "speaker": "Speaker_A",
      "start": 31.01,
      "end": 34.61,
      "text": "ਦਸ ਪਸ਼ੂ ਆ ਦੁੱਧ ਵਾਲੇ ਅਤੇ ਨਾਲ ਜਿਹੜੇ ਛੋਟੇ ਬੱਚੇ ਨਾਲ ਰਲਾ ਕੇ ਹੈ ਨਾ"
    },
    {
      "speaker": "Speaker_B",
      "start": 33.99,
      "end": 34.34,
      "text": "ਹਾਂਜੀ"
    },
    {
      "speaker": "Speaker_B",
      "start": 34.86,
      "end": 36.38,
      "text": "ਪੰਜ ਦੁੱਧ ਵਾਲੇ ਜੀ ਬਾਕੀ ਛੋਟੇ"
    },
    {
      "speaker": "Speaker_A",
      "start": 36.54,
      "end": 41.95,
      "text": "ਠੀਕ ਹੈ ਕੀ ਲੱਗਦਾ ਵੀਰ ਜੀ ਤੁਹਾਨੂੰ ਅੱਜ ਦੇ ਟਾਈਮ ਚ ਮਤਲਬ ਦੁੱਧ ਦੇ ਕਿੱਤੇ ਦੇ ਵਿੱਚੋਂ ਤੁਹਾਨੂੰ ਵਧੀਆ ਪ੍ਰੋਫਿਟ ਹੋ ਰਿਹਾ"
    },
    {
      "speaker": "Speaker_B",
      "start": 42.53,
      "end": 48.89,
      "text": "ਵੀਰ ਜੀ ਬਹੁਤ ਦੁੱਧ ਦੇ ਕਿੱਤੇ ਦੇ ਵਿੱਚੋਂ ਵੀ ਹੋ ਰਿਹਾ ਜੀ ਅਤੇ ਦੁੱਧ ਦੇ ਨਾਲੋਂ ਜਾਨਵਰ ਸਾਂਭਣ ਦੇ ਅਤੇ ਸੇਲ ਕਰਨ ਦੇ ਵਿੱਚ ਵੀ ਜ਼ਿਆਦਾ"
    },
    {
      "speaker": "Speaker_A",
      "start": 48.97,
      "end": 55.43,
      "text": "ਉਹਦੇ ਚ ਵੀ ਫਾਇਦਾ ਹੈਗਾ ਠੀਕ ਹੈ ਬਾਕੀ ਤੁਸੀਂ ਜਿਆਦਾ ਬਰੀਡ ਲੈਵਲ ਤੇ ਕੰਮ ਕਰ ਰਹੇ ਹੈ ਨਾ ਦੁੱਧ ਨਾਲੋਂ ਜ਼ਿਆਦਾ ਬਰੀਡ ਤੇ ਧਿਆਨ ਆ"
    },
    {
      "speaker": "Speaker_B",
      "start": 49.87,
      "end": 50.27,
      "text": "ਹਾਂਜੀ"
    },
    {
      "speaker": "Speaker_B",
      "start": 53.27,
      "end": 53.69,
      "text": "ਹਾਂਜੀ"
    },
    {
      "speaker": "Speaker_B",
      "start": 54.73,
      "end": 59.83,
      "text": "ਦੁੱਧ ਤੋਂ ਜ਼ਿਆਦਾ ਬਰੀਡ ਤੇ ਕਿਉਂਕਿ ਜੀ ਬੱਚੇ ਤਿਆਰ ਕਰਕੇ ਉਹਨਾਂ ਨੂੰ ਸੇਲ ਕਰਨ ਦੇ ਵਿੱਚ ਜ਼ਿਆਦਾ ਮੁਨਾਫਾ ਜੀ"
    },
    {
      "speaker": "Speaker_A",
      "start": 57.41,
      "end": 57.83,
      "text": "ਹਮ"
    },
    {
      "speaker": "Speaker_A",
      "start": 60.02,
      "end": 60.46,
      "text": "ਠੀਕ ਹੈ"
    },
    {
      "speaker": "Speaker_B",
      "start": 60.72,
      "end": 62.0,
      "text": "ਵੀਹ ਪਲੱਸ ਹੀ ਨੀਲੀ ਰਾਵੀ ਹੈ ਜੀ ਅਤੇ ਵੀਹ ਪਲੱਸ ਹੀ"
    }
  ],
