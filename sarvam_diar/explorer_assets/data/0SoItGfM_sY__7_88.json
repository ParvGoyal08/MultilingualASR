  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 2.35,
      "end": 3.97,
      "text": "ನಾನು ಒಂದು ವರ್ಷದಿಂದ ಆಪ್ ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ"
    },
    {
      "speaker": "Speaker_B",
      "start": 4.03,
      "end": 5.69,
      "text": "ಇದರಿಂದ ತುಂಬಾ ಯೂಸಸ್ ಇದೆ"
    },
    {
      "speaker": "Speaker_C",
      "start": 5.75,
      "end": 9.03,
      "text": "ನಾನು ಸುಮಾರು ಹತ್ತು ತಿಂಗಳಿಂದ ಆಪ್ಅನ್ನ ಬಳಸ್ತಾ ಇದ್ದೀನಿ"
    },
    {
      "speaker": "Speaker_A",
      "start": 9.17,
      "end": 13.36,
      "text": "ಈ ಆಪ್ಇಂದ ಏನೇನು ಪ್ರಯೋಜನ ಆಯ್ತು ಅಂತಂದ್ರೆ ಹೊರಗಡೆ ಎಲ್ಲೂ ಸಿಗಲಾರದಂತಹ ಇನ್ಫಾರ್ಮೇಷನ್ ಇದೆ"
    },
    {
      "speaker": "Speaker_B",
      "start": 13.39,
      "end": 21.09,
      "text": "ಫಾರ್ಮಿಂಗಲ್ಲಿ ಆಗಿರಬಹುದು ಪರ್ಸನಲ್ ಫೈನಾನ್ಸ್ ಹ್ಯಾಂಡಲ್ ಮಾಡೋದಾಗಿರಬಹುದು ಮತ್ತೆ ಬಿಸಿನೆಸ್ ಮಾಡೋರಿಗೂ ಕೂಡ ಆಗಿರಬಹುದು ತುಂಬಾನೇ ಯೂಸ್ಫುಲ್ ಇದೆ"
    },
    {
      "speaker": "Speaker_C",
      "start": 21.33,
      "end": 24.27,
      "text": "ಈ ಆಪ್ app ಬಳಸೋದ್ರಿಂದ ನಾನು ಕೃಷಿ ಭೂಮಿಯನ್ನು ಕೊಂಡಿದ್ದೀನಿ"
    },
    {
      "speaker": "Speaker_D",
      "start": 24.48,
      "end": 29.01,
      "text": "ಕಿರಣಿ ಅಂಗಡಿ ಮಾಡಿ ಚೆನ್ನಾಗಿದ್ದೀವಿ ಅದಕ್ಕೆ ಸರ್ ಗೆ ಥ್ಯಾಂಕ್ಸ್ ಹೇಳ್ಬೇಕು ಅಂತಾನೆ ಬಂದಿದ್ದು"
    },
    {
      "speaker": "Speaker_E",
      "start": 33.39,
      "end": 50.65,
      "text": "ನನ್ನ ಮೇಲೆ ನನಗೆ ನಂಬಿಕೆ ಇದ್ದಾಗ ಎಲ್ಲಾ ಹೋದ್ರು ಚಿಂತೆ ಇಲ್ಲ ನಾಳೆ ಮತ್ತೆ ಇಷ್ಟನ್ನ ಸಂಪಾದನೆ ಮಾಡ್ತೀನಿ ಅನ್ನೋ ಕಾನ್ಫಿಡೆನ್ಸ್ ಬರುತ್ತೆ ಪ್ರತಿಯೊಬ್ಬ ವ್ಯಕ್ತಿಯಲ್ಲೂ ಅದು ಬರಬೇಕು ಸೋ ಅದಕ್ಕೆ ನಾನು ಯೋಚನೆ ಮಾಡ್ತಿದ್ದೆ ನಮ್ಮ ದೇಶದಲ್ಲಿ ಶ್ರೀಮಂತನಿಗೂ ಬಡವನಿಗೂ ಏನಪ್ಪಾ ಡಿಫರೆನ್ಸ್ ಎರಡೇ ಜ್ಞಾನ ಅವಕಾಶ ನಾಲೆಡ್ಜ್ ಆಪರ್ಚುನಿಟಿ"
    },
    {
      "speaker": "Speaker_E",
      "start": 51.59,
      "end": 55.21,
      "text": "ಇದು ಎರಡು ಯಾರಿಗಿದೆ ಅವನು ಶ್ರೀಮಂತ ಯಾರಿಗಿಲ್ಲ ಅವನು ಬಡವ"
    },
    {
      "speaker": "Speaker_E",
      "start": 56.38,
      "end": 68.96,
      "text": "ಸೋ ಜ್ಞಾನ ಮತ್ತೆ ಅವಕಾಶ ಯಾಕೆ ಎಲ್ಲರಿಗೂ ಸಿಗಲ್ಲ ನಮಗೆ ಇವತ್ತು ಜ್ಞಾನ ಪೂರ್ತಿ ಸೆಕೆಂಡ್ ಹ್ಯಾಂಡ್ ಯಾರೋ ಏನೋ ಮಾಡ್ತಾರೆ ಅದನ್ನ ನೋಡಿ ಇನ್ನೊಬ್ಬ ಬುಕ್ ಬರೀತಾನೆ ಆ ಬುಕ್ ಓದಿ ಮತ್ತೊಬ್ಬರು ನಮಗೆ ಪಾಠ ಮಾಡ್ತಾರೆ"
    },
    {
      "speaker": "Speaker_E",
      "start": 70.49,
      "end": 81.0,
      "text": "ನಮಗೆ ಫಸ್ಟ್ ಹ್ಯಾಂಡ್ ಇನ್ಫಾರ್ಮೇಷನ್ ಸಿಗಲ್ಲ ಇವತ್ತು ಟೆಕ್ನಾಲಜಿ ಅದನ್ನ ಸಾಧ್ಯ ಮಾಡಿದೆ ಸೋ ಯಾರು ಸಾಧನೆ ಮಾಡಿದ್ದಾರೆ ಅವರಿಂದ ಪಾಠ ಮಾಡ್ಸಬೇಕು ಅನ್ನೋದು ನಮ್ಮ ಉದ್ದೇಶ ಸೋ ಫೈನಾನ್ಸಿಯಲ್ ಫ್ರೀಡಂ ಆಪ್ಲ್ಲಿ ನಾವು ಕೋರ್ಸ್ ಮಾಡಿ ಒಂದೊಂದು ಕೋರ್ಸಿಗೆ ಇಂತಿಷ್ಟು"
    }
  ],
