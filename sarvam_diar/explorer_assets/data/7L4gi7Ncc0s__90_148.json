  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 0.01,
      "end": 12.83,
      "text": "ട്രാൻസ്പോട്ട് വകുപ്പ് മന്ത്രി ശ്രീ ആന്റണി രാജു മറ്റ് തിരുവനന്തപുരത്തെ എം എൽ എമാർ അർജുന അവാർഡ്കൾ അതുപോലെതന്നെ പ്രധാനപ്പെട്ട കായിക കായിക അധ്യാപകർ"
    },
    {
      "speaker": "Speaker_A",
      "start": 14.03,
      "end": 17.39,
      "text": "വിവിധ സ്കൂളുകളിലും കോളേജുകളിലും ഉള്ള കുട്ടികൾ"
    },
    {
      "speaker": "Speaker_A",
      "start": 18.45,
      "end": 22.33,
      "text": "എല്ലാവരും പങ്കെടുത്തുകൊണ്ടുള്ള വമ്പിച്ച റാലിയാണ് അന്ന് നടക്കുന്നത്"
    },
    {
      "speaker": "Speaker_B",
      "start": 22.39,
      "end": 52.39,
      "text": "ലെറ്റ്സ് മൂവ് എന്നതാണ് അന്താരാഷ്ട്ര ഒളിമ്പിക് കമ്മിറ്റിയുടെ ഈ വർഷത്തെ ഒളിമ്പിക് ദിന സന്ദേശം ജീവിതശൈലിയിൽ കുറഞ്ഞുവരുന്ന ശാരീരിക കായികക്ഷമത ഉയർത്തുക എന്നതാണ് ഈ സന്ദേശത്തിന്റെ ലക്ഷ്യം കേരളത്തിൽ വർദ്ധിച്ചുവരുന്ന ലഹരി മയക്കുമരുന്ന് ഉപയോഗത്തിനെതിരായും ഇത്തവണത്തെ ക്യാമ്പയിൻ കേരള ഒളിമ്പിക് അസോസിയേഷൻ ഉപയോഗപ്പെടുത്തും ലെറ്റ്സ് മൂവ് നോ ടു ഡ്രഗ്സ് എന്നാണ് ക്യാമ്പയിൻന്റെ പേര് അഞ്ച് ലക്ഷം രൂപയും ഫലകവും പ്രശസ്തിപത്രവും അടങ്ങുന്ന രണ്ടായിരത്തി ഇരുപത്തിരണ്ട്ലെ കെ ഒ എ സ്പോർട്സ് മാൻ ഓഫ് ദി ഇയർ സ്പോർട്സ് എക്സലൻസ് അവാർഡ് ബാഡ്മിന്റൺ താരം എച്ച് എസ് പ്രണോയിക്കാണ് രണ്ടായിരത്തി ഇരുപത്തിരണ്ട്ലെ ഗോൾഡൻ ഗ്ലോബ് റേസിൽ രണ്ടാം സ്ഥാനം കരസ്ഥമാക്കിയ"
    },
    {
      "speaker": "Speaker_B",
      "start": 52.39,
      "end": 58.0,
      "text": "അഭിലാഷ് ടോമിയെ അഡ്വഞ്ചർ സ്പോർട്സ് പേഴ്സൺ എന്ന നിലയിൽ കേരള ഒളിമ്പിക് അസോസിയേഷൻ association ആദരിക്കും പ്രശസ്തിപത്രവും ഫലകവും അടങ്ങുന്ന പുരസ്കാരമാണ് അഭിലാഷ് ടോമി ക്ക് സമ്മാനിക്കുന്നത്"
    }
  ],
