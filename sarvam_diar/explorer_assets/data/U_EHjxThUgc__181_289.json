  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 0.01,
      "end": 17.21,
      "text": "যাকে আমরা বলি কমিউনিটি হেলথ কেয়ার প্রোভাইডার অর্থাৎ কমিউনিটিতে যিনি স্বাস্থ্যসেবা প্রদান করেন এবং সেখানে তিরিশ ধরনের ওষুধ পাওয়া যায় কাজেই মানুষ প্রাথমিক স্বাস্থ্য পরিচর্যা বলতে যা বোঝায় সেগুলো সবাই কমিউনিটি ক্লিনিক থেকে পাচ্ছে এবং আমরা খেয়াল করে দেখেছি যে বাংলাদেশের জনসংখ্যা যত"
    },
    {
      "speaker": "Speaker_B",
      "start": 17.05,
      "end": 17.47,
      "text": "জি"
    },
    {
      "speaker": "Speaker_A",
      "start": 17.53,
      "end": 25.83,
      "text": "তত মানুষ হলো এক বছরে বা তার চেয়ে বেশি মানুষ এক বছরে এই সমস্ত ক্লিনিক থেকে হলো সেবা নেয় হয়তো প্রশ্ন আসতে পারে যে মানুষের চেয়ে বেশি কী করে হলো সেবা নেন"
    },
    {
      "speaker": "Speaker_B",
      "start": 25.95,
      "end": 26.07,
      "text": "জি"
    },
    {
      "speaker": "Speaker_A",
      "start": 26.19,
      "end": 36.53,
      "text": "কারণটা হলো যে এক মানুষ কিন্তু একাধিকবার হলো কমিউনিটি ক্লিনিকএ আসেন সেই সংখ্যা হিসেবে আমরা দেখছি যে বাংলাদেশের জনসংখ্যারও অধিক মানুষ কমিউনিটি ক্লিনিক থেকে সেবা নেয়"
    },
    {
      "speaker": "Speaker_B",
      "start": 34.83,
      "end": 51.63,
      "text": "মানে বারবার আসার জন্য বারবার আসার জন্য ধন্যবাদ আমি আসছি আপনার কাছে পরে ডক্টর আবুল কালাম আজাদ জুলফিকার লেনিন আপনি মাননীয় প্রধানমন্ত্রীর দপ্তরের পরিচালক হিসেবে কাজ করছেন আমি আমরা মাঝে মধ্যে পত্রপত্রিকা এবং বিভিন্ন চ্যানেলএ আমরা দেখে আসছি যে স্বাস্থ্য"
    },
    {
      "speaker": "Speaker_B",
      "start": 51.83,
      "end": 71.77,
      "text": "খাতটা হলো সেবা খাত এই সেবা দেওয়ার ক্ষেত্রে চিকিৎসকদের চিকিৎসকদের একটা অত্যন্ত ভূমিকা রয়েছে গুরুত্বপূর্ণ ভূমিকা রয়েছে সে প্রেক্ষাপটে অনেক সময় আমরা লক্ষ্য করেছি যে যারা চিকিৎসকগুলো যারা আছেন তারা প্রত্যন্ত অঞ্চলে গ্রামে গঞ্জে আপনি যেটা বলছিলেন যে কমিউনিটি ক্লিনিকএর কথা বলছেন অনেকে আগ্রহী হন না"
    },
    {
      "speaker": "Speaker_B",
      "start": 72.15,
      "end": 84.23,
      "text": "এর পেছনে কারণ কি ওখানে কি কোন ফ্যাসিলিটির অভাব রয়েছে বা কোন রকমের অসুবিধা হয় যাওয়া আসা হতে শুরু করে থাকা এবং ইনস্ট্রুমেন্ট এবং যেটা স্বাস্থ্য ঠিক মত দেওয়া যাচ্ছে না আপনার কি মনে হয়"
    },
    {
      "speaker": "Speaker_C",
      "start": 84.73,
      "end": 95.93,
      "text": "ধন্যবাদ আসলে যেটা লক্ষণীয় চিকিৎসকরা যেতে চান না বিষয়টা ওরকম না চিকিৎসকরা যে কোনোভাবেই হোক না কেন তারা স্টেশনএ থাকেন এবং আমরা রাখছি"
    },
    {
      "speaker": "Speaker_A",
      "start": 94.65,
      "end": 98.91,
      "text": "না ম্যাক্সিমাম ঢাকা কেন্দ্রিক মানে গুপ্ত শিবিরের মাধ্যমে আসতে চান"
    },
    {
      "speaker": "Speaker_C",
      "start": 96.41,
      "end": 108.0,
      "text": "বলছি বলছি সেটা হলো যে বিভিন্ন বিষয় এর সাথে জড়িত একটা হচ্ছে যে আমি কোথায় বড় হয়েছি আমি কোথায় পড়াশোনা করেছি আমার কোথায় বন্ধুবান্ধব আছে এইটার তো একটা বিষয় থাকেই পরিবেশগত যে এখানে আমি ভালো থাকি"
    }
  ],
