  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 0.01,
      "end": 0.89,
      "text": "करने हैं मुझे वो"
    },
    {
      "speaker": "Speaker_B",
      "start": 1.07,
      "end": 1.65,
      "text": "हुँ"
    },
    {
      "speaker": "Speaker_A",
      "start": 1.49,
      "end": 4.21,
      "text": "मुझे बिल्कुल ही मैं इडनी फ़ाइन महसूस कर रहा हूँ"
    },
    {
      "speaker": "Speaker_B",
      "start": 4.19,
      "end": 22.45,
      "text": "अंकल हमारे सत्तर साल के हैं तो एज इज नॉट द लिमिट फॉर स्पाइन सर्जरी बिल्कुल बढ़िया है और ऑपरेशन भी हमने मिनिमल इनविजिबल कुछ छोटे से चीरे से हमने इनका एक लेवल का टिलिफ किया है इसमें दो मणकों को हमने आपस में फ्यूज किया है फिक्स भी किया है और उस लेवल का डिस्क निकाला है"
    },
    {
      "speaker": "Speaker_B",
      "start": 23.17,
      "end": 37.27,
      "text": "बाकी आपको यही मैसेज है कि कोई भी स्पाइन का पेशेंट कोई भी अगर इस समस्या से जूझ रहा है जिसमें नसों पे दबाव है पैर सुन्न होते हैं और पैरों में कमजोरी भी तक आ गया है तो उसका वेट मत करें हमारे हीलिंग हॉस्पिटल में आएं"
    },
    {
      "speaker": "Speaker_B",
      "start": 37.79,
      "end": 57.35,
      "text": "और हम उसको पहले असेस करेंगे बताएंगे जो रियलिटी है सामने बैठ के पूरा असेस करेंगे और फिर जो भी बीमारी के बारे हम कर सकते हैं उसके बारे में हम पूरा डिस्कस करेंगे और स्पाइन के रिलेटेड आपका कोई भी क्वेरी है तो आप प्लीज नीचे दिए हुए नंबर उस पे कॉल कर सकते हैं और पूछ सकते हैं अंकल आप कुछ बोलना चाहेंगे एंड का रिमार्क कुछ"
    },
    {
      "speaker": "Speaker_B",
      "start": 57.69,
      "end": 58.29,
      "text": "खुश हैं"
    },
    {
      "speaker": "Speaker_A",
      "start": 57.81,
      "end": 70.0,
      "text": "जी मैं बहुत खुश हूँ जी मैं ये कहूँगा जिसको भी ऐसी प्रॉब्लम है एक बार हीलिंग हॉस्पिटल में आकर के चंडीगढ़ में चौंतीस सेक्टर के अंदर डॉक्टर अजय सिंह से जरूर मुलाकात करें बाकी जैसे भी सजेसन देंगे सही सजेसन कोई आपको गलत रास्ते में नहीं डालेंगे"
    }
  ],
