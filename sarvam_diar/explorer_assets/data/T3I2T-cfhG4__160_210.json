  "utterances": [
    {
      "speaker": "Speaker_A",
      "start": 0.01,
      "end": 4.79,
      "text": "भारताचा वर्तमान आणि भविष्य तिघांनाही पहिला प्रश्न आहे एकेकानं उत्तर द्यावं असं वाटतं"
    },
    {
      "speaker": "Speaker_A",
      "start": 5.31,
      "end": 6.81,
      "text": "भविष्याकडे जायच्या आधी"
    },
    {
      "speaker": "Speaker_A",
      "start": 7.13,
      "end": 11.03,
      "text": "तुम्ही सर्वजण आपापल्या क्षेत्रामध्ये आणि त्यामुळे समाजामध्ये"
    },
    {
      "speaker": "Speaker_A",
      "start": 11.22,
      "end": 15.2,
      "text": "गेल्या दोन दशकाहून अधिक काळ ऍक्टिव्हेट आहात ऍक्टिव्ह आहात त्याच्याहून जास्तच वेळ"
    },
    {
      "speaker": "Speaker_A",
      "start": 15.44,
      "end": 19.71,
      "text": "तुम्हाला कसा भारत बदलताना दिसला आणि आत्ता आपण कुठे आहोत हे प्रत्येकानं सांगा"
    },
    {
      "speaker": "Speaker_B",
      "start": 20.13,
      "end": 25.87,
      "text": "आत्ता चांगली प्रगती आपल्या देशाची होतीये आत्ता जो मोमेंटम म्हणजे याच्यातला एक जो भाग आहे"
    },
    {
      "speaker": "Speaker_B",
      "start": 26.41,
      "end": 40.35,
      "text": "की माझा असा ठाम विश्वास आहे की एकटा माणसाचं जेव्हा तो प्रगतीच्या पथावर चालायला लागतो त्यावेळेला एकूणात अ देश म्हणून प्रगती होणं हे नेहमी प साध्य होत असतं"
    },
    {
      "speaker": "Speaker_B",
      "start": 40.59,
      "end": 44.68,
      "text": "तसे प सकारात्मक प्रयत्न करणारे विविध क्षेत्रातली लोकं आहेत"
    },
    {
      "speaker": "Speaker_B",
      "start": 45.11,
      "end": 47.42,
      "text": "ज्यांच्यामुळे आत्ता जिथे भारत आहे"
    },
    {
      "speaker": "Speaker_B",
      "start": 47.54,
      "end": 50.0,
      "text": "तिथून तो यापेक्षा पुढेच जात राहील आणि तो या लोकांच्या प्रयत्नां"
    }
  ],
