      "skipped": null,
      "lang": "te-IN"
    },
    {
      "i": 5,
      "start": 20.56,
      "end": 22.13,
      "speaker": "SPEAKER_02",
      "text": "మీ స్టైల్లో.",
      "skipped": null,
      "lang": "te-IN"
    },
    {
      "i": 6,
      "start": 22.17,
      "end": 32.19,
      "speaker": "SPEAKER_03",
      "text": "మీ సైల్ లో వీళ్ళు నా సైల్ లో వీళ్ళు. ఓకే. పిలు విక్రమ్. విక్రమ్ తో కుకింగ్ చేయాలంటే ఓటు అంటే ఓటు వేస్తున్నావ్ మొర్రి బింకడు కళ్ళు మోకాళ్ళ వంటివి పట్టుకొని వస్తున్నావ్.",
      "skipped": null,
      "lang": "te-IN"
    },
    {
      "i": 7,
      "start": 32.19,
      "end": 33.4,
      "speaker": "SPEAKER_04",
      "text": "వచ్చినావా వచ్చినావా",
      "skipped": null,
      "lang": "te-IN"
    },
    {
      "i": 8,
      "start": 33.22,
      "end": 33.63,
