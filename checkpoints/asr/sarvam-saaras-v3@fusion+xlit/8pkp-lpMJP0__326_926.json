    },
    {
      "i": 53,
      "start": 145.3,
      "end": 147.06,
      "speaker": "SPEAKER_04",
      "text": "అరేయ్ ఆ హీరో పేరు తెలుసా నీకు?",
      "skipped": null,
      "lang": "te-IN"
    },
    {
      "i": 54,
      "start": 147.37,
      "end": 152.09,
      "speaker": "SPEAKER_03",
      "text": "ए पेर मुनी की वृक्षा रु वृक्ष तन रुक्षा",
      "skipped": null,
      "lang": "hi-IN"
