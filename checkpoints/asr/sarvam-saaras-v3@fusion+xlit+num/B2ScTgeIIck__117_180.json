    {
      "i": 1,
      "start": 0.53,
      "end": 1.61,
      "speaker": "SPEAKER_00",
      "text": "ଶେଷ ବେଳେ ବିଧାୟକ ପାଇଁ।",
      "skipped": null,
      "lang": "od-IN"
    },
    {
      "i": 2,
      "start": 1.79,
      "end": 4.49,
      "speaker": "SPEAKER_01",
      "text": "ବିଧାୟକ ପାଇଁ, ତାପରେ ଆପଣ ଆଉ ବିଧାୟକ ଭାବରେ କେବେ?",
