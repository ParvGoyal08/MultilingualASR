    {
      "i": 2,
      "start": 2.51,
      "end": 4.23,
      "speaker": "SPEAKER_02",
      "text": "இந்த கோட்டிங் வந்து அதுதானா இது?",
      "skipped": null,
      "lang": "ta-IN"
    },
    {
      "i": 3,
      "start": 4.13,
      "end": 5.45,
      "speaker": "SPEAKER_00",
      "text": "அதுக்குதான் கொடுத்துருக்கோம்.",
      "skipped": null,
      "lang": "ta-IN"
    },
    {
      "i": 4,
      "start": 5.77,
      "end": 6.59,
      "speaker": "SPEAKER_02",
      "text": "ஓகே ஓகே ஓகே.",
      "skipped": null,
      "lang": "ta-IN"
    },
    {
      "i": 5,
      "start": 6.65,
      "end": 10.11,
      "speaker": "SPEAKER_00",
      "text": "ஏரோ கிளாஸ் கோட்டட் அடு ஏரோ கிளாஸ் கோட்டட் இது அடு",
      "skipped": null,
      "lang": "en-IN"
    },
    {
      "i": 6,
      "start": 10.31,
      "end": 11.81,
      "speaker": "SPEAKER_02",
      "text": "அக்கா என்ன படிச்சிருக்கீங்கக்கா?",
      "skipped": null,
      "lang": "ta-IN"
    },
    {
      "i": 7,
      "start": 10.33,
      "end": 10.93,
      "speaker": "SPEAKER_00",
